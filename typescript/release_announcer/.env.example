# Run without any API key: model calls return canned results.
RELEASE_MOCK_MODE=1

# Or use a real model: comment out the line above and set a key.
# OPENAI_API_KEY="sk-..."
# RELEASE_MODEL="openai/gpt-6-luna"

# Sleeps are measured in "hours"; 1 second per hour keeps the demo short.
# RELEASE_SECONDS_PER_HOUR=1
