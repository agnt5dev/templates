    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agnt5/sdk": "^0.10.15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
