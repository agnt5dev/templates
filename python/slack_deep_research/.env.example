# Slack Deep Research - Environment Variables
# Copy this file to .env and fill in your values.

# OpenAI API key for the three agents (they use openai/gpt-6-luna).
OPENAI_API_KEY="your-openai-api-key-here"

# AGNT5 service key with the run and workflow scopes. The workflow uses it to resume
# itself when someone clicks Approve or Reject in Slack. Create one with:
#   agnt5 service-keys create --name slack-approver --project <project-id> --scopes run,workflow
# Don't name it AGNT5_*: `agnt5 dev` doesn't pass AGNT5_* variables from .env to the worker.
APPROVAL_SERVICE_KEY="agnt5_sk_..."

# SLACK_BOT_TOKEN is not needed here: the AGNT5 Slack integration passes the bot token
# to the workflow with each event.
