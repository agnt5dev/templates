__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.venv-local

.env

# AGNT5: commit the project link so git worktrees and fresh clones find the
# project; keep the local worker state (PIDs, logs, IDs) out of git.
.agnt5/*
!.agnt5/project-ref
