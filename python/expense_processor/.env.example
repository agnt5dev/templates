# Run without any API key: the receipts are read from canned results.
EXPENSES_MOCK_MODE=1

# Or read the receipts with a real model: comment out the line above and set a key.
# OPENAI_API_KEY="sk-..."
# EXPENSES_MODEL="openai/gpt-6-luna"

# The payout window is measured in hours; 1 second per hour keeps the demo short.
# EXPENSES_SECONDS_PER_HOUR=1
